FROM python@sha256:9e01bf1ae5db7649a236da7be1e94ffbbbdd7a93f867dd0d8d5720d9e1f89fab

WORKDIR /app

# Build deps (torch/transformers native extensions) + worker build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ openssl wget make rustc libolm-dev \
    && rm -rf /var/lib/apt/lists/*

# Install signal-cli (A3) — GraalVM native binary (no JRE needed)
# Data dir (keys + trust store) lives on a bind mount at /app/signal-data.
ARG SIGNAL_CLI_VERSION=0.14.2
RUN wget -q "https://github.com/AsamK/signal-cli/releases/download/v${SIGNAL_CLI_VERSION}/signal-cli-${SIGNAL_CLI_VERSION}-Linux-native.tar.gz" \
    -O /tmp/signal-cli.tar.gz \
    && tar xf /tmp/signal-cli.tar.gz -C /usr/local/bin \
    && chmod +x /usr/local/bin/signal-cli \
    && rm /tmp/signal-cli.tar.gz
# Symlink root's signal-cli dir to the bind mount path so that
# `podman exec` commands (which run as root) use the same data
# store as the daemon (which uses --config /app/signal-data)
RUN mkdir -p /root/.local/share && \
    ln -s /app/signal-data /root/.local/share/signal-cli

# PostgreSQL 17 server (in-container, socket-only) + pgvector extension
RUN apt-get update && apt-get install -y --no-install-recommends \
    postgresql-17 \
    postgresql-server-dev-17 \
    git \
    && cd /tmp \
    && git clone --branch v0.8.0 --depth 1 https://github.com/pgvector/pgvector.git \
    && cd pgvector && make && make install \
    && cd / && rm -rf /tmp/pgvector \
    && apt-get purge -y postgresql-server-dev-17 git && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Initialise PostgreSQL data directory (owned by postgres user)
# Actual initdb runs in entrypoint on first boot (needs writable /data volume)
RUN mkdir -p /data/pgdata && chown -R postgres:postgres /data/pgdata

# Q13.fix.f — create the runtime directory that hosts Sentinel's internal
# Unix sockets (sidecar + signal-cli). The podman-compose tmpfs entry
# overmounts this path at container start with mode=0700; the mkdir here
# ensures the mount point exists in the image layer and the expected perms
# are set pre-mount. See docs/hardening/2026-04-20-hardening-Q13-protocol-
# auth-findings.md §Design Cluster 2 Decision 3.
RUN mkdir -p /run/sentinel && chmod 700 /run/sentinel

COPY pyproject.toml .

# Install torch CPU-only first (separate index), then the rest
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir ".[dev,mcp,worker]"

# C67: fail the build if PTB resolution doesn't satisfy the pin or the
# contract test surface (10-setter chain, filter expression, version
# parser). The contract test file deliberately has no Sentinel imports
# so it can run with only pyproject.toml + tests/ in the build context.
COPY tests/test_telegram_ptb_contract.py tests/test_telegram_ptb_contract.py
RUN python -m pytest tests/test_telegram_ptb_contract.py -x -q

# Pre-download Prompt Guard model at build time (uses HF token via build secret)
RUN --mount=type=secret,id=hf_token \
    HF_TOKEN=$(cat /run/secrets/hf_token) \
    python -c "from transformers import pipeline; pipeline('text-classification', model='meta-llama/Llama-Prompt-Guard-2-86M')"

# Pre-download FlashRank reranker model at build time into a persistent cache
# (matches the Prompt Guard bake above). Avoids a ~33MB HF re-download on every
# container start and removes the reranker's startup egress dependency.
# Loader default (sentinel/memory/reranker.py) prefers /opt/flashrank when present.
RUN python -c "from flashrank import Ranker; Ranker(model_name='ms-marco-MiniLM-L-12-v2', cache_dir='/opt/flashrank', max_length=512)"

COPY sentinel/ ./sentinel/
COPY rules/ ./rules/
COPY tests/ ./tests/
COPY ui/ ./ui/

# WASM sidecar binary + tool modules (pre-built on host, Phase 4)
COPY sidecar/target/release/sentinel-sidecar ./sidecar/sentinel-sidecar
RUN chmod +x ./sidecar/sentinel-sidecar
COPY sidecar/wasm/ ./wasm/

# Radicale CalDAV server config + container entrypoint
COPY container/radicale.conf /app/radicale.conf
COPY container/entrypoint.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

# Generate self-signed TLS cert at build time (swap for real cert in production)
RUN mkdir -p /data /app/tls /logs /workspace && \
    openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout /app/tls/sentinel.key \
    -out /app/tls/sentinel.crt \
    -subj "/CN=sentinel/O=Sentinel"

EXPOSE 8443 8080

CMD ["/app/entrypoint.sh"]
